{
  "name": "spanlight",
  "version": "0.1.0",
  "description": "Tracing for LLM applications: send OpenAI and Anthropic calls to Spanlight with tokens, cost, latency and errors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dheerajkarwasra/spanlight.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/dheerajkarwasra/spanlight/tree/main/sdks/typescript#readme",
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "openai",
    "anthropic",
    "spanlight"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.135.0",
    "openai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "openai": "^7.39.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
