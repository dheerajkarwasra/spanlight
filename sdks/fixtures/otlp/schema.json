{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanlight.dev/schemas/otlp-fixture.json",
  "title": "OTLP compatibility fixture",
  "description": "One exporter library at one pinned version: the exact bytes each scenario exported and the rows Spanlight is expected to store for them (spec section 8.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["library", "version", "recorded_at", "recorder", "scenarios"],
  "properties": {
    "library": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "otel_sdk", "harness"],
      "properties": {
        "runtime": { "type": "string" },
        "otel_sdk": { "type": "string" },
        "harness": { "type": "string" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"], "minimum": 0 },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "export", "preview", "expected"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_type", "body_base64"],
          "properties": {
            "content_type": { "enum": ["application/x-protobuf", "application/json"] },
            "body_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceSpans"],
          "properties": { "resourceSpans": { "type": "array" } }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected", "spans", "trace", "loses"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["span_id", "reason"],
            "properties": {
              "span_id": { "$ref": "#/$defs/nullableString" },
              "reason": { "type": "string" }
            }
          }
        },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["span_count", "input_tokens", "output_tokens", "has_unpriced"],
          "properties": {
            "span_count": { "type": "integer", "minimum": 0 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "has_unpriced": { "type": "boolean" }
          }
        },
        "loses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id", "parent_span_id", "convention", "kind", "provider", "model", "usage",
        "usage_rollup", "usage_state", "finish_reason", "input_present", "output_present",
        "time_to_first_token_ms", "status", "error_class", "operation", "trace"
      ],
      "properties": {
        "span_id": { "type": "string" },
        "parent_span_id": { "$ref": "#/$defs/nullableString" },
        "convention": { "enum": ["gen_ai", "openinference", "vercel_ai", "traceloop", "none"] },
        "kind": { "enum": ["llm", "tool", "retrieval", "chain", "http", "other"] },
        "provider": { "$ref": "#/$defs/nullableString" },
        "model": { "$ref": "#/$defs/nullableString" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "cached_tokens", "cache_write_tokens"],
          "properties": {
            "input_tokens": { "$ref": "#/$defs/nullableInteger" },
            "output_tokens": { "$ref": "#/$defs/nullableInteger" },
            "cached_tokens": { "$ref": "#/$defs/nullableInteger" },
            "cache_write_tokens": { "$ref": "#/$defs/nullableInteger" }
          }
        },
        "usage_rollup": { "type": "boolean" },
        "usage_state": {
          "enum": [
            "priced", "rollup", "usage_not_reported", "partial_usage", "model_unknown",
            "no_price", "not_applicable"
          ]
        },
        "finish_reason": {
          "enum": ["stop", "length", "tool_calls", "content_filter", "other", null]
        },
        "input_present": { "type": "boolean" },
        "output_present": { "type": "boolean" },
        "time_to_first_token_ms": { "type": ["number", "null"], "minimum": 0 },
        "status": { "enum": ["ok", "error", "unset"] },
        "error_class": { "$ref": "#/$defs/nullableString" },
        "operation": { "$ref": "#/$defs/nullableString" },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "environment", "release", "user_id", "session_id", "metadata"],
          "properties": {
            "name": { "$ref": "#/$defs/nullableString" },
            "environment": { "$ref": "#/$defs/nullableString" },
            "release": { "$ref": "#/$defs/nullableString" },
            "user_id": { "$ref": "#/$defs/nullableString" },
            "session_id": { "$ref": "#/$defs/nullableString" },
            "metadata": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
