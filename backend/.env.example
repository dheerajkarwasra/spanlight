# Copy to backend/.env for local development. Every value can also come from the environment.

# Connect as an ordinary (non-superuser, non-BYPASSRLS) role, or row-level security is bypassed.
DATABASE_URL=postgresql+psycopg://spanlight_app:spanlight_app@localhost:5432/spanlight

# Public origin of the app: Origin allowlist and the cookie `Secure` flag (https => Secure).
APP_BASE_URL=http://localhost:8000
# Extra comma-separated origins allowed to make state-changing requests (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173

# HMAC key for CSRF tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Bearer token protecting GET /metrics. Leave unset to disable the endpoint (404).
METRICS_TOKEN=
# Swagger UI at /api/docs (its script comes from cdn.jsdelivr.net). Unset: on when APP_BASE_URL is
# http, off when it is https. /api/openapi.json is always served.
# API_DOCS=

# Master key(s) that encrypt stored secrets such as two-factor seeds (optional). Format:
# <id>:<base64 of 32 bytes>[,<id>:<base64>...]; the first entry seals new data.
# Generate with: echo "v1:$(openssl rand -base64 32)"
CREDENTIALS_KEYS=

# Enterprise license key (optional). Unset runs the community edition; code under ee/ directories
# needs a key. `uv run spanlight license-status` shows what a key grants.
EE_LICENSE_KEY=

# Demo traffic (optional). Without a key the demo job is skipped and no data is generated.
ANTHROPIC_API_KEY=
DEMO_MONTHLY_BUDGET_USD=1.00
# Defaults to true when ANTHROPIC_API_KEY is set.
# DEMO_ENABLED=true

# Review loop. The nightly job fills each project's review queue; off, a policy can still be run by
# hand. Replays spend at most this much per project per UTC month and need CREDENTIALS_KEYS;
# 0 turns replay off.
# REVIEW_SELECTION_ENABLED=true
# REPLAY_MONTHLY_BUDGET_USD=5.00

# Email (optional): verification and password-reset mail. Features that need email stay off
# until it is configured. EMAIL_PROVIDER is console (default), resend or smtp.
# EMAIL_PROVIDER=resend
# Sender address, required for resend and smtp.
# EMAIL_FROM=Spanlight <noreply@example.com>
# Required for resend.
# RESEND_API_KEY=
# SMTP_HOST is required for smtp; the username and password are optional. Turn STARTTLS off only
# for a trusted local relay: mail and password then travel in clear text.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# Console provider: append each message to this file as one JSON line (development, e2e tests).
# Without a file the console provider only logs recipient and subject, and email counts as off.
# EMAIL_CONSOLE_FILE=.local/emails.jsonl

# Sign in with GitHub and Google (optional). A provider is on when both of its values are set;
# setting only one stops startup. The callback URL to register with the provider is
# ${APP_BASE_URL}/api/v1/auth/oauth/<github|google>/callback.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# How long an API request waits for a database connection, and how long one of its statements may
# run, before it fails with 503 and Retry-After.
# API_POOL_TIMEOUT_SECONDS=5
# API_STATEMENT_TIMEOUT_SECONDS=10

# Connections kept for idempotency keys, apart from the main pool, and how long a request waits
# for one before it fails. Each use lasts a few milliseconds; the defaults rarely need changing.
# IDEMPOTENCY_POOL_SIZE=5
# IDEMPOTENCY_POOL_TIMEOUT_SECONDS=5

SENTRY_DSN=

# Optional self-tracing: the api traces its requests, queries and outbound calls, and the worker its
# queries and outbound calls, to an OTLP HTTP collector (spans go to <endpoint>/v1/traces). Point it
# at another Spanlight instance's /v1/otlp, or at your own collector. Request bodies, headers and
# query parameters are never recorded. Off while the endpoint is empty.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=spanlight-api

LOG_LEVEL=INFO
# Set to false for human-readable console logs.
LOG_JSON=true
