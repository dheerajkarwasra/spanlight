# The released images to run. Comment both out (or start with --build) to build from the checkout.
# Verify the signatures and pin the digest: https://spanlight.dev/docs/self-hosting/upgrades/#verify-a-release
SPANLIGHT_IMAGE=ghcr.io/dheerajkarwasra/spanlight:0.7.0
SPANLIGHT_WEB_IMAGE=ghcr.io/dheerajkarwasra/spanlight-web:0.7.0

# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# At least 32 characters unless APP_BASE_URL is localhost, 127.0.0.1 or [::1]; the api refuses
# to start otherwise. The command above gives 43.
SECRET_KEY=
# Bearer token for Prometheus. /metrics is served by the api only (api:8000/metrics), not
# through the web port. The worker serves its own /metrics on worker:9100 (WORKER_METRICS_PORT is
# set in compose.yaml, port not published) and accepts the same token.
METRICS_TOKEN=
# Swagger UI at /api/docs (its script comes from cdn.jsdelivr.net). Unset: on when APP_BASE_URL is
# http, off when it is https. /api/openapi.json is always served.
# API_DOCS=

# Optional: master key(s) that encrypt stored secrets such as two-factor seeds and gateway provider
# credentials. Back them up: a lost key cannot be recovered.
# Generate with: echo "v1:$(openssl rand -base64 32)"
CREDENTIALS_KEYS=

# Terms of service users must accept. Blank (self-hosted): no terms are asked for anywhere. The
# hosted service sets it to the terms page VERSION (frontend/src/features/legal/content/terms.tsx).
TERMS_VERSION=

# Optional LLM gateway: point an OpenAI or Anthropic client at ${APP_BASE_URL}/gw/v1 with a
# gateway key and every call is traced. Provider credentials are stored sealed with
# CREDENTIALS_KEYS above, so set that first: without it, saving a credential answers
# 409 NOT_CONFIGURED.
# embedded (default): the api serves /gw/*. standalone: a separate gateway process serves it
# (start the stack with `--profile standalone-gateway` and set GATEWAY_UPSTREAM=gateway:8000
# below). disabled: no gateway. Set the same GATEWAY_MODE for the api and the gateway process.
# GATEWAY_MODE=embedded
# Per-process HTTP ingress, independent of dashboard/health capacity; slots last through stream
# cleanup. Replicas multiply concurrency and memory. Internal playground/worker calls are outside
# these caps. A call needs a free slot, room in the byte budget (its Content-Length, 10 MiB when
# the body is chunked or undeclared, nothing for GET/HEAD/OPTIONS) and a free share for its key.
# Memory follows the byte budget.
# GATEWAY_MAX_IN_FLIGHT=512
# GATEWAY_MAX_IN_FLIGHT_BYTES=83886080
# GATEWAY_MAX_IN_FLIGHT_PER_KEY=256
# Where the web service sends /gw/*. Leave it at the api unless the gateway runs standalone.
# GATEWAY_UPSTREAM=api:8000
# Allow provider base URLs that are http:// or point at private, loopback or link-local
# addresses (a local model server, for example). Keep it off on a shared deployment.
# GATEWAY_ALLOW_INSECURE_BASE_URLS=false
# Requests per minute one organization may send through the gateway across all its keys. Unset
# means no ceiling. Set it when several organizations share the deployment.
# GATEWAY_ORG_RPM_CEILING=
# Gateway spans are written after the answer (a failed write is retried): how many writes run
# at once and how many may wait before new ones are dropped (counted in
# spanlight_gateway_record_failures_total and in gateway_spans_lost on /health/ready). A waiting
# span's input and output are cut to 1 MiB each, and the waiting spans' payloads together stay
# within GATEWAY_RECORD_BACKLOG_MB of stored JSON; the memory they take in the process is larger,
# so size both by what the api can spare. The writes run on the pool requests use (10 + 10
# overflow), so keep the concurrency at or below 10: more writers than that let a burst of span
# writes take the connections gateway calls need.
# GATEWAY_RECORD_CONCURRENCY=8
# GATEWAY_RECORD_BACKLOG=5000
# GATEWAY_RECORD_BACKLOG_MB=128

# Alerts. Slack, webhook and PagerDuty channels keep their secrets sealed with CREDENTIALS_KEYS
# above; without it, saving one answers 409 NOT_CONFIGURED. Email channels need an email
# provider (below). Turn off the alert evaluation job or the Monday digest email:
# ALERTS_EVALUATION_ENABLED=true
# WEEKLY_DIGEST_ENABLED=true
# Allow webhook channels to use http:// URLs and private, loopback or link-local addresses (a
# receiver inside your network, for example). Keep it off on a shared deployment.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Allow email channels to send to any address. Off, every recipient must be a member of the
# organization with a verified email. Keep it off on a shared deployment.
# ALERT_EMAIL_ANY_RECIPIENT=false
# Where PagerDuty channels send events (the Events API v2 endpoint).
# PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# Doctor. Turn off the detector job (every 15 minutes) or the per-user daily stats refresh:
# DETECTORS_ENABLED=true
# USER_STATS_ENABLED=true
# Consumption only; capture stays active. Off is degraded for materialized observations.
# Follow docs/runbooks/aggregate-repair.md before enabling after both checkpoints.
AGGREGATE_REPAIR_ENABLED=false
# "Explain with Claude" uses the organization's own Anthropic gateway credential. The model must
# have a price. The budget is per organization per UTC month, in US dollars; 0 turns it off.
# EXPLAIN_MODEL=claude-sonnet-5-5
# EXPLAIN_MONTHLY_BUDGET_USD=1.00

# Evaluations. Turn off online evaluation (sampling recent spans for enabled evaluators every
# minute); evaluators still run inside experiments. LLM judges spend through the organization's
# provider credential, capped by each evaluator's monthly budget.
# EVALS_ENABLED=true
# Most runs one evaluator gets per one-minute sampling cycle.
# EVAL_SAMPLER_MAX_RUNS_PER_CYCLE=50
# Ceiling for the number of dataset items one experiment run may process.
# EXPERIMENT_MAX_ITEMS=1000
# Weekly experiment reruns. Off by default: turn on the daily job that reruns every experiment
# marked "weekly" once per ISO week (unattended paid calls, each run under its own cost limit).
# EXPERIMENT_SCHEDULES_ENABLED=false

# Billing sources. Turn off the daily fetch of connected provider cost reports; false stops every
# provider cost-API call (an air-gapped instance), the routes stay and a manual refresh answers
# 409 NOT_CONFIGURED.
# BILLING_SOURCES_ENABLED=true

# Audit log. Days an audit event is kept before the hourly retention job deletes it; 0 keeps every
# event. The default is the 12 months PCI DSS 10.5.1 asks for.
# AUDIT_RETENTION_DAYS=365

# Provider status. Turn off the 5-minute poll of the providers' public status pages; false fetches
# nothing (an air-gapped instance) and the incident list says so.
# PROVIDER_STATUS_POLLING_ENABLED=true

# Attribution. Turn off the 15-minute attribution rollup refresh; windows longer than a day go
# stale while windows of 24 hours or less stay live.
# ATTRIBUTION_ENABLED=true

# Live dashboards. Open tabs refetch when their project gets new data, over a server-sent event
# stream; false turns the stream and its 1 s change check off and tabs poll. Most streams one api
# process holds (then 503 LIVE_BUSY), and most dashboard answers it caches.
# LIVE_UPDATES_ENABLED=true
# LIVE_MAX_STREAMS=2000
# LIVE_CACHE_ENTRIES=5000

# Enterprise license key (spl_lic_...). Blank runs the community edition; a key that does not
# verify stops startup, an expired one turns enterprise features off.
# EE_LICENSE_KEY=

# Public URL the dashboard is served from (used for the Origin allowlist and Secure cookies).
APP_BASE_URL=http://localhost:8080
WEB_PORT=8080

# Optional: behind your own reverse proxy that sets X-Real-IP, list its address ranges
# (space-separated CIDRs) so rate limits and session records see real client IPs.
TRUSTED_PROXIES=

# Optional: extra origins (comma-separated) allowed to make state-changing API requests from a
# browser. APP_BASE_URL is always allowed; leave this empty unless another site calls the API.
# ALLOWED_ORIGINS=

# Optional: enables the live demo workspace, fed by real Claude Haiku calls.
ANTHROPIC_API_KEY=
DEMO_MONTHLY_BUDGET_USD=1.00
# Force the demo workspace on or off. Unset means on exactly when ANTHROPIC_API_KEY is set.
# DEMO_ENABLED=

# Optional email (verification and password reset). The worker sends it. Leave it all unset to
# keep email off. EMAIL_PROVIDER is resend, smtp or console (console only logs recipient and
# subject, so it does not turn email on by itself).
# EMAIL_PROVIDER=resend
# Sender address, required for resend and smtp.
# EMAIL_FROM=Spanlight <noreply@example.com>
# Required for resend.
# RESEND_API_KEY=
# SMTP_HOST is required for smtp; the username and password are optional. Port 465 uses implicit
# TLS (SMTPS) instead of STARTTLS, for networks that block 587. Turn STARTTLS off only
# for a trusted local relay: mail and password then travel in clear text.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# Console provider only: also append each message to this file as one JSON line (development).
# EMAIL_CONSOLE_FILE=

# Optional sign-in with GitHub and Google. A provider appears on the login page when both of its
# values are set; set only one and the app refuses to start. Register the callback URL with the
# provider: ${APP_BASE_URL}/api/v1/auth/oauth/github/callback (or .../google/callback).
# GitHub: Settings > Developer settings > OAuth Apps. Google: Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Optional S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...), used for trace
# exports. It is on when S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY are all set; set only some
# and the app refuses to start. AWS buckets need S3_REGION (for example eu-west-1).
# S3_ENDPOINT is for non-AWS services; set S3_FORCE_PATH_STYLE=true for MinIO and most
# self-hosted ones. S3_PUBLIC_ENDPOINT is only for when browsers reach the store at a different
# address than the server does; download links are signed against it.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Optional nightly database backup (03:00 UTC). Only worker receives these settings.
# Explicit backup storage is independent of S3_*; no generic or ambient fallback.
# Set the bucket/access/secret trio together. Use a private encrypted bucket and a distinct
# upload principal with s3:PutObject and s3:AbortMultipartUpload on backups/* only.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_FORCE_PATH_STYLE=false
# Server-side encryption on each backup upload. Leave blank for MinIO without a KMS.
# BACKUP_S3_SSE=AES256
# BACKUP_DATABASE_URL must bypass forced RLS: superuser or BYPASSRLS, never the app role.
# Bundled database: postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/spanlight
# BACKUPS_ENABLED=true
# BACKUP_DATABASE_URL=
# Retention runs separately: schedule `spanlight backup prune --apply` daily with a separate
# operator-only List/Delete principal supplied through BACKUP_S3_*. Preview first without --apply.
# Never give retention or recovery credentials to API/worker or put them in this runtime env.
# Policy keeps 14 UTC days, 8 Sundays, newest overall, future and unknown keys.
# Without the separate schedule, backups continue and storage grows. See restore runbook.

# /health/ready answers 503 when no worker has reported in the last 120 seconds, because
# notifications and exports only move while the worker runs. Set WORKER_REQUIRED=false only for a
# deployment that deliberately runs the API without one.
# WORKER_REQUIRED=true

# How long an API request waits for a database connection, and how long one of its statements may
# run, before it fails with 503 and Retry-After. Empty keeps the defaults shown.
# API_POOL_TIMEOUT_SECONDS=1.0
# API_STATEMENT_TIMEOUT_SECONDS=10.0
# Past this many /api and /v1 requests in flight, one api process answers 503 at once.
# API_MAX_IN_FLIGHT=64
# Past this many ingest requests in flight for one project (all its keys, native and OTLP), one
# api process answers 429 with Retry-After: 1 before reading the body. Per process, so replicas
# multiply it.
# INGEST_MAX_IN_FLIGHT_PER_PROJECT=8
# Seconds one api process reuses an API key's row; a key revoked through another process keeps
# working on this one for up to this long. 0 reads the key on every request.
# API_KEY_CACHE_TTL_SECONDS=10

# Per-project ingest caps on POST /v1/traces and /v1/otlp/traces: sustained spans a second
# (bursts of at least a full 1000-span batch), spans a UTC day and decompressed body bytes a UTC
# day. Over a cap the request is 429 with Retry-After and the refused spans are shown to the
# project. 0 = unlimited; empty keeps the defaults shown. One project's own caps:
# `spanlight set-ingest-caps <project-id> ...`. The gateway's own spans are not capped.
# INGEST_SPANS_PER_SECOND=1000
# INGEST_SPANS_PER_DAY=1000000
# INGEST_BYTES_PER_DAY=5368709120

# Connection pools that idempotency keys and rate limiting use, apart from the main one. Size
# them for your concurrency; empty keeps the defaults shown.
# IDEMPOTENCY_POOL_SIZE=5
# IDEMPOTENCY_POOL_TIMEOUT_SECONDS=5.0
# RATE_LIMIT_POOL_SIZE=5
# RATE_LIMIT_POOL_TIMEOUT_SECONDS=0.25
# SQL deadlines on token-bucket connections only; require 0 < lock < statement.
# Separate from checkout and full request/cancellation cleanup wall time.
# RATE_LIMIT_LOCK_TIMEOUT_MS=100
# RATE_LIMIT_STATEMENT_TIMEOUT_MS=250

# Logging: DEBUG, INFO, WARNING or ERROR; JSON lines unless LOG_JSON=false.
# LOG_LEVEL=INFO
# LOG_JSON=true

# Optional error reporting.
SENTRY_DSN=

# Optional self-tracing: the api and the worker send OpenTelemetry spans about their own requests
# and queries to an OTLP HTTP collector (spans go to <endpoint>/v1/traces). Request bodies,
# headers and query parameters are never recorded. Off while the endpoint is empty.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=spanlight-api

# One first-signal shutdown deadline. External stop grace must exceed the total (75s default).
# Unjoined DB users retain pools beyond the deadline until external hard stop; accounting is incomplete.
SHUTDOWN_TIMEOUT_SECONDS=60
SHUTDOWN_WORK_SECONDS=50
SHUTDOWN_FLUSH_SECONDS=3
SHUTDOWN_CLOSE_SECONDS=2
