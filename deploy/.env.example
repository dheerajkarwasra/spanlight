# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SECRET_KEY=
# Bearer token for Prometheus. /metrics is served by the api only (api:8000/metrics), not
# through the web port. The worker serves its own /metrics on worker:9100 (WORKER_METRICS_PORT is
# set in compose.yaml, port not published) and accepts the same token.
METRICS_TOKEN=

# Optional: master key(s) that encrypt stored secrets such as two-factor seeds and gateway provider
# credentials. Back them up: a lost key cannot be recovered.
# Generate with: echo "v1:$(openssl rand -base64 32)"
CREDENTIALS_KEYS=

# Optional LLM gateway: point an OpenAI or Anthropic client at ${APP_BASE_URL}/gw/v1 with a
# gateway key and every call is traced. Provider credentials are stored sealed with
# CREDENTIALS_KEYS above, so set that first: without it, saving a credential answers
# 409 NOT_CONFIGURED.
# embedded (default): the api serves /gw/*. standalone: a separate gateway process serves it
# (start the stack with `--profile standalone-gateway` and set GATEWAY_UPSTREAM=gateway:8000
# below). disabled: no gateway. Set the same GATEWAY_MODE for the api and the gateway process.
# GATEWAY_MODE=embedded
# Where the web service sends /gw/*. Leave it at the api unless the gateway runs standalone.
# GATEWAY_UPSTREAM=api:8000
# Allow provider base URLs that are http:// or point at private, loopback or link-local
# addresses (a local model server, for example). Keep it off on a shared deployment.
# GATEWAY_ALLOW_INSECURE_BASE_URLS=false
# Requests per minute one organization may send through the gateway across all its keys. Unset
# means no ceiling. Set it when several organizations share the deployment.
# GATEWAY_ORG_RPM_CEILING=
# Gateway spans are written after the answer: how many writes run at once and how many may
# wait before new ones are dropped (counted in spanlight_gateway_record_failures_total).
# GATEWAY_RECORD_CONCURRENCY=16
# GATEWAY_RECORD_BACKLOG=1000

# Alerts. Slack, webhook and PagerDuty channels keep their secrets sealed with CREDENTIALS_KEYS
# above; without it, saving one answers 409 NOT_CONFIGURED. Email channels need an email
# provider (below). Turn off the alert evaluation job or the Monday digest email:
# ALERTS_EVALUATION_ENABLED=true
# WEEKLY_DIGEST_ENABLED=true
# Allow webhook channels to use http:// URLs and private, loopback or link-local addresses (a
# receiver inside your network, for example). Keep it off on a shared deployment.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Allow email channels to send to any address. Off, every recipient must be a member of the
# organization with a verified email. Keep it off on a shared deployment.
# ALERT_EMAIL_ANY_RECIPIENT=false
# Where PagerDuty channels send events (the Events API v2 endpoint).
# PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# Doctor. Turn off the detector job (every 15 minutes) or the per-user daily stats refresh:
# DETECTORS_ENABLED=true
# USER_STATS_ENABLED=true
# "Explain with Claude" uses the organization's own Anthropic gateway credential. The model must
# have a price. The budget is per organization per UTC month, in US dollars; 0 turns it off.
# EXPLAIN_MODEL=claude-sonnet-5-5
# EXPLAIN_MONTHLY_BUDGET_USD=1.00

# Evaluations. Turn off online evaluation (sampling recent spans for enabled evaluators every
# minute); evaluators still run inside experiments. LLM judges spend through the organization's
# provider credential, capped by each evaluator's monthly budget.
# EVALS_ENABLED=true
# Most runs one evaluator gets per one-minute sampling cycle.
# EVAL_SAMPLER_MAX_RUNS_PER_CYCLE=50
# Ceiling for the number of dataset items one experiment run may process.
# EXPERIMENT_MAX_ITEMS=1000

# Public URL the dashboard is served from (used for the Origin allowlist and Secure cookies).
APP_BASE_URL=http://localhost:8080
WEB_PORT=8080

# Optional: behind your own reverse proxy that sets X-Real-IP, list its address ranges
# (space-separated CIDRs) so rate limits and session records see real client IPs.
TRUSTED_PROXIES=

# Optional: extra origins (comma-separated) allowed to make state-changing API requests from a
# browser. APP_BASE_URL is always allowed; leave this empty unless another site calls the API.
# ALLOWED_ORIGINS=

# Optional: enables the live demo workspace, fed by real Claude Haiku calls.
ANTHROPIC_API_KEY=
DEMO_MONTHLY_BUDGET_USD=1.00
# Force the demo workspace on or off. Unset means on exactly when ANTHROPIC_API_KEY is set.
# DEMO_ENABLED=

# Optional email (verification and password reset). The worker sends it. Leave it all unset to
# keep email off. EMAIL_PROVIDER is resend, smtp or console (console only logs recipient and
# subject, so it does not turn email on by itself).
# EMAIL_PROVIDER=resend
# Sender address, required for resend and smtp.
# EMAIL_FROM=Spanlight <noreply@example.com>
# Required for resend.
# RESEND_API_KEY=
# SMTP_HOST is required for smtp; the username and password are optional. Port 465 uses implicit
# TLS (SMTPS) instead of STARTTLS, for networks that block 587. Turn STARTTLS off only
# for a trusted local relay: mail and password then travel in clear text.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# Console provider only: also append each message to this file as one JSON line (development).
# EMAIL_CONSOLE_FILE=

# Optional sign-in with GitHub and Google. A provider appears on the login page when both of its
# values are set; set only one and the app refuses to start. Register the callback URL with the
# provider: ${APP_BASE_URL}/api/v1/auth/oauth/github/callback (or .../google/callback).
# GitHub: Settings > Developer settings > OAuth Apps. Google: Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Optional S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...), used for backups and
# exports. It is on when S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY are all set; set only some
# and the app refuses to start. AWS buckets need S3_REGION (for example eu-west-1).
# S3_ENDPOINT is for non-AWS services; set S3_FORCE_PATH_STYLE=true for MinIO and most
# self-hosted ones. S3_PUBLIC_ENDPOINT is only for when browsers reach the store at a different
# address than the server does; download links are signed against it.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Optional nightly database backup (03:00 UTC) to the object storage above; keeps the newest of
# each of the last 14 days and of the last 8 Sundays. It runs when BACKUP_DATABASE_URL is set and
# object storage is on; BACKUPS_ENABLED=false turns it off. The tables use forced row-level
# security and pg_dump needs to bypass it, so use a superuser or a role with BYPASSRLS, never the
# app role (managed Postgres: create a BYPASSRLS role). With the bundled database, for example:
#   postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/spanlight
# Compose passes both variables to the worker only; the api never sees BACKUP_DATABASE_URL.
# A dump holds every prompt and completion: keep the bucket private and encrypted at rest.
# BACKUPS_ENABLED=true
# BACKUP_DATABASE_URL=

# /health/ready answers 503 when no worker has reported in the last 120 seconds, because
# notifications and exports only move while the worker runs. Set WORKER_REQUIRED=false only for a
# deployment that deliberately runs the API without one.
# WORKER_REQUIRED=true

# How long an API request waits for a database connection, and how long one of its statements may
# run, before it fails with 503 and Retry-After. Empty keeps the defaults shown.
# API_POOL_TIMEOUT_SECONDS=5.0
# API_STATEMENT_TIMEOUT_SECONDS=10.0

# Connection pools that idempotency keys and rate limiting use, apart from the main one. Size
# them for your concurrency; empty keeps the defaults shown.
# IDEMPOTENCY_POOL_SIZE=5
# IDEMPOTENCY_POOL_TIMEOUT_SECONDS=5.0
# RATE_LIMIT_POOL_SIZE=5
# RATE_LIMIT_POOL_TIMEOUT_SECONDS=0.25

# Logging: DEBUG, INFO, WARNING or ERROR; JSON lines unless LOG_JSON=false.
# LOG_LEVEL=INFO
# LOG_JSON=true

# Optional error reporting.
SENTRY_DSN=

# Optional self-tracing: the api and the worker send OpenTelemetry spans about their own requests
# and queries to an OTLP HTTP collector (spans go to <endpoint>/v1/traces). Request bodies,
# headers and query parameters are never recorded. Off while the endpoint is empty.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=spanlight-api
