{
  "name": "spanlight-docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The Spanlight documentation site (Astro Starlight), served at /docs/.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "test": "npm run sync && node --test 'scripts/lib/*.test.mjs' 'src/lib/*.test.mjs'"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.8",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-sidebar-topics": "0.9.0"
  }
}
