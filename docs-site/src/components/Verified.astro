---
/**
 * "Tested with": the date a page's instructions were last run against real packages, and the
 * exact versions used. One quiet line, so the page can claim only what was checked. `date` is
 * YYYY-MM-DD. `packages` is optional (a migration page has none); `note` is an optional
 * short note, for example a minimum version some feature needs.
 */
interface Props {
  date: string;
  packages?: { name: string; version: string }[];
  note?: string;
}
const { date, packages = [], note } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
const month = parts ? MONTHS[Number(parts[2]) - 1] : undefined;
if (!parts || !month) throw new Error(`<Verified date="${date}"> must be a YYYY-MM-DD date`);
const shownDate = `${Number(parts[3])} ${month} ${parts[1]}`;

const names = packages.map((pkg) => `${pkg.name} ${pkg.version}`);
const list =
  names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
---

<aside class="verified not-content" aria-label="Verification">
  <p class="label"><span class="dot" aria-hidden="true"></span>Verified</p>
  <p class="line">
    Tested on <time datetime={date}>{shownDate}</time>{list && ` with ${list}`}.
  </p>
  {note && <p class="line">{note}</p>}
</aside>

<style>
  .verified {
    margin-block: 1.5rem;
    padding: 0.875rem 1rem;
    border-radius: 1.125rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }
  p {
    margin: 0;
  }
  .label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.3;
    color: var(--spl-success);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--spl-success);
  }
  .line {
    overflow-wrap: anywhere;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .line + .line {
    margin-top: 0.375rem;
  }
</style>
